                    "hidden_layers": 6,
                    "embedding_layers": 2,
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "last_action",
                            "history_actor"
                        ]
                    }
                },
                "critic": {
                    "name": "ForwardArchi",
                    "hidden_dim": 2048,
                    "model": "residual",
                    "hidden_layers": 6,
                    "embedding_layers": 2,
                    "num_parallel": 2,
                    "ensemble_mode": "batch",
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "privileged_state",
                            "last_action",
                            "history_actor"
                        ]
                    }
                },
                "discriminator": {
                    "name": "DiscriminatorArchi",
                    "hidden_dim": 1024,
                    "hidden_layers": 3,
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "privileged_state"
                        ]
                    }
                },
                "aux_critic": {
                    "name": "ForwardArchi",
                    "hidden_dim": 2048,
                    "model": "residual",
                    "hidden_layers": 6,
                    "embedding_layers": 2,
                    "num_parallel": 2,
                    "ensemble_mode": "batch",
                    "input_filter": {
                        "name": "DictInputFilterConfig",
                        "key": [
                            "state",
                            "privileged_state",
                            "last_action",
                            "history_actor"
                        ]
                    }
                }
            },
